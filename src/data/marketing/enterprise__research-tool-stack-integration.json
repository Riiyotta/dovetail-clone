     "el": "strong"
    },
    {
     "role": "h2",
     "text": "Getting started",
     "el": "h2"
    },
    {
     "role": "text",
     "placeholder": true,
     "chars": 139,
     "el": "p"
    },
    {
     "role": "text",
     "text": "Map what exists and where information gets stuck.",
     "el": "li"
    },
    {
     "role": "text",
     "text": "Audit your current tools and data flows.",
     "el": "strong"
    },
    {
     "role": "text",
     "text": "The path from customer insight to product decision is usually the best place to start.",
     "el": "li"
    },
    {
     "role": "text",
     "text": "Pick one high-value workflow to integrate first.",
     "el": "strong"
    },
    {
     "role": "text",
     "text": "Agree on the dimensions that matter for your team's decision-making and apply them consistently.",
     "el": "li"
    },
    {
     "role": "text",
     "text": "Define your tagging taxonomy.",
     "el": "strong"
    },
    {
     "role": "text",
     "text": "Use what's available before building custom solutions.",
     "el": "li"
    },
    {
     "role": "text",
     "text": "Start with native integrations.",
