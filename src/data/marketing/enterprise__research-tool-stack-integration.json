    {
     "role": "text",
     "placeholder": true,
     "chars": 224,
     "el": "li"
    },
    {
     "role": "text",
     "text": "Research findings reach decision-makers.",
     "el": "strong"
    },
    {
     "role": "text",
     "placeholder": true,
     "chars": 198,
     "el": "li"
    },
    {
     "role": "text",
     "text": "Feedback from multiple channels is unified.",
     "el": "strong"
    },
    {
     "role": "text",
     "placeholder": true,
     "chars": 167,
     "el": "li"
    },
    {
     "role": "text",
     "text": "Prioritization is grounded in evidence.",
     "el": "strong"
    },
    {
     "role": "text",
     "placeholder": true,
     "chars": 202,
     "el": "li"
    },
    {
     "role": "text",
     "text": "Redundant work decreases.",
     "el": "strong"
    },
    {
