  "title": "Request a demo | Dovetail",
  "description": "Discover the power of Dovetail with a personalized demo. Explore the benefits of a customer insights hub for seamless collaboration and discovery."
 },
 "sections": [
  {
   "type": "heroForm",
   "eyebrow": "Talk to Sales",
   "h1": "Turn insights into action",
   "intro": {
    "placeholder": true,
    "chars": 231
   },
   "bullets": [
    {
     "title": "A premium tour",
     "text": "We'll answer your questions and dive into the features your team will love."
    },
    {
     "title": "See it in action",
     "text": "Watch how your feedback, insights, and data come together in one place."
    },
    {
     "title": "AI at work",
     "text": "Live examples of always-on analysis, agents, and automated workflows."
    },
    {
     "title": "Your own workspace",
     "text": "We'll set up a premium workspace so you can test it with your team."
    }
   ],
   "form": {
    "id": "mql-on-submission",
    "staticNonSubmitting": true,
    "fields": [
     {
      "name": "email",
      "id": "sf-email",
      "control": "input",
      "type": "email",
      "label": "Email",
      "required": true,
      "placeholder": "jane@acmeinc.com",
      "autocomplete": "email",
      "inputmode": "email"
     },
     {
      "name": "firstname",
      "id": "sf-firstname",
      "control": "input",
      "type": "text",
      "label": "First name",
      "required": true,
      "placeholder": "Jane",
      "autocomplete": "given-name"
     },
     {
      "name": "lastname",
      "id": "sf-lastname",
      "control": "input",
      "type": "text",
      "label": "Last name",
      "required": true,
      "placeholder": "Doe",
      "autocomplete": "family-name"
     },
     {
      "name": "company",
      "id": "sf-company",
      "control": "input",
      "type": "text",
      "label": "Company name",
      "required": true,
      "placeholder": "Acme Inc.",
      "autocomplete": "organization"
     },
     {
      "name": "jobtitle",
      "id": "sf-jobtitle",
      "control": "input",
      "type": "text",
      "label": "Job title",
      "required": true,
      "placeholder": "Product Manager",
      "autocomplete": "organization-title"
     },
     {
      "name": "company_size",
      "id": "sf-company-size",
      "control": "select",
      "label": "Company size",
      "required": true,
      "options": [
       "Please Select",
       "1-25",
       "26-200",
       "201-500",
       "501-1000",
       "1001-5000",
       "5000+"
