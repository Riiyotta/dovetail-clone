      "placeholderOption": {
       "text": "Please Select",
       "value": "",
       "disabled": true,
       "selected": true
      }
     },
     {
      "name": "bant1",
      "id": "sf-bant1",
      "control": "select",
      "label": "What is your biggest challenge right now?",
      "required": true,
      "options": [
       "Please Select",
       "Increase operational efficiency and reduce cost (rapid analysis and synthesis)",
       "Reduce customer information silos (Central Repository)",
       "Process high volume customer feedback (support tickets, app store reviews, etc.)",
       "Other"
      ],
      "placeholderOption": {
       "text": "Please Select",
       "value": "",
       "disabled": true,
       "selected": true
      }
     },
     {
      "name": "bant2",
      "id": "sf-bant2",
      "control": "select",
      "label": "What best describes your role in the purchase process?",
      "required": true,
      "options": [
       "Please Select",
       "End-user/Researcher",
       "Recommender/Influencer",
       "Budget holder/Decision-maker"
      ],
      "placeholderOption": {
       "text": "Please Select",
       "value": "",
       "disabled": true,
       "selected": true
      }
     },
     {
      "name": "bant3",
      "id": "sf-bant3",
      "control": "select",
      "label": "How soon are you looking to implement a solution?",
      "required": true,
      "options": [
       "Please Select",
       "Immediately",
       "Within 1–3 months",
       "3–6 months",
       "More than 6 months",
       "Evaluating"
      ],
      "placeholderOption": {
       "text": "Please Select",
       "value": "",
       "disabled": true,
       "selected": true
      }
     },
     {
      "name": "bant4",
      "id": "sf-bant4",
      "control": "select",
      "label": "What is your expected budget for this project?",
      "required": true,
      "options": [
       "Please Select",
       "Less than $5,000",
       "$5,000–$25,000",
       "$25,000–$50,000",
       "More than $50,000"
      ],
      "placeholderOption": {
       "text": "Please Select",
       "value": "",
       "disabled": true,
       "selected": true
      }
     },
     {
      "name": "phone",
      "id": "sf-phone",
      "control": "input",
      "type": "tel",
      "label": "Phone number",
      "required": false
     },
     {
      "name": "message",
      "id": "sf-message",
      "control": "textarea",
      "label": "Is there any other information you'd like to share with us?",
      "required": false
     }
    ],
    "rowPairs": [
     [
      "firstname",
      "lastname"
     ]
    ],
    "consent": {
     "text": [
      {
       "placeholder": true,
       "chars": 222
      },
      "Terms of Service",
      "Privacy Policy"
     ],
