{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "section contract",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "title",
  "semantic",
  "source",
  "purpose",
  "retrievalEligible",
  "placement",
  "variants",
  "content",
  "assets",
  "generatedAssetRoles",
  "style",
  "constraints",
  "motion",
  "responsive",
  "runtimeUi",
  "measuredHeightsPx",
  "evidence"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^(shell|hero|content|features|social-proof|cta|conversion|interactive|listing|article|pricing|comparison|company|event|legal|utility)\\.[a-z0-9-]+$"
  },
  "title": {
   "type": "string",
   "minLength": 3
  },
  "semantic": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "category"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "category": {
     "enum": [
      "SHELL",
      "HERO",
      "CONTENT",
      "FEATURES",
      "SOCIAL_PROOF",
      "CTA",
      "CONVERSION",
      "INTERACTIVE",
      "LISTING",
      "ARTICLE",
      "PRICING",
      "COMPARISON",
      "COMPANY",
      "EVENT",
      "LEGAL",
      "UTILITY"
     ]
    }
   }
  },
  "source": {
   "$ref": "#/definitions/source"
  },
  "purpose": {
   "type": "string",
   "minLength": 20
  },
  "retrievalEligible": {
   "type": "boolean"
  },
  "retrievalIneligibleReason": {
   "type": "string",
   "minLength": 30
  },
  "placement": {
   "enum": [
    "main",
    "chrome",
    "overlay"
   ],
   "description": "main = in the page flow (measured by the wrapper gate); chrome = site shell outside <main>; overlay = portal/fixed UI with no page height"
  },
  "variants": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "description",
     "requiredFields",
     "forbiddenFields",
     "observedOnRoutes",
     "observedOn",
     "contentSampled"
    ],
    "properties": {
     "description": {
      "type": "string"
     },
     "requiredFields": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "forbiddenFields": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "observedOnRoutes": {
      "type": "integer",
      "minimum": 1
     },
     "observedOn": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "contentSampled": {
      "type": "boolean"
     }
    }
   }
  },
  "content": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "budgetRule",
    "requiredFields",
    "fields",
    "listSizes",
    "itemRequiredFields",
    "bodyBlockKinds"
   ],
   "properties": {
    "budgetRule": {
     "type": "string"
    },
    "requiredFields": {
     "type": "array"
    },
    "fields": {
     "type": "object"
    },
    "listSizes": {
     "type": "object"
    },
    "itemRequiredFields": {
     "type": "array"
    },
    "bodyBlockKinds": {
     "type": "array"
    }
   }
  },
  "assets": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "fields",
    "note"
   ],
   "properties": {
    "fields": {
     "type": "object"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "generatedAssetRoles": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "style": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "props",
    "note"
   ],
   "properties": {
    "props": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "allowed"
      ],
      "properties": {
       "kind": {
        "enum": [
         "token"
        ]
       },
       "allowed": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "string"
        }
       }
      }
     }
    },
    "note": {
     "type": "string"
    }
   }
  },
  "constraints": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "maxPerPage",
    "consecutiveVariants"
   ],
   "properties": {
    "maxPerPage": {
     "type": "integer",
     "minimum": 1
    },
    "consecutiveVariants": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "motion": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "allowedPatterns",
    "requiredPatterns",
    "reducedMotionFallback",
    "note"
   ],
   "properties": {
    "allowedPatterns": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "requiredPatterns": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "reducedMotionFallback": {
     "type": "object"
    },
    "note": {
     "type": "string"
    }
   }
  },
  "responsive": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "range",
     "behavior"
    ],
    "properties": {
     "range": {
      "type": "string"
     },
     "behavior": {
      "type": "string",
      "minLength": 3
     }
    }
   }
  },
  "runtimeUi": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "part",
     "behavior"
    ],
    "properties": {
     "part": {
      "type": "string",
      "minLength": 3
     },
     "behavior": {
      "type": "string",
      "minLength": 12
     }
    }
   }
  },
  "measuredHeightsPx": {
   "type": "object",
   "required": [
    "1440"
   ]
  },
  "evidence": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^[^\\s:]+:[0-9]+(-[0-9]+)?( .*)?$"
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "retrievalEligible": {
      "const": false
     }
    }
   },
   "then": {
    "required": [
     "retrievalIneligibleReason"
    ]
   }
  }
 ],
 "definitions": {
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "file",
    "tag",
    "lines",
    "tagLine",
    "anchor",
    "anchorLine"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^component:"
    },
    "file": {
     "type": "string",
     "pattern": "^src/"
    },
    "tag": {
     "type": "string",
     "minLength": 1
    },
    "lines": {
     "type": "string",
     "pattern": "^[0-9]+-[0-9]+$"
    },
    "tagLine": {
     "type": "integer",
     "minimum": 1
    },
    "anchor": {
     "type": "string",
     "minLength": 2
    },
    "anchorLine": {
     "type": "integer",
     "minimum": 1
    }
   }
  }
 }
}
